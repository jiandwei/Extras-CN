{
    "version": "0.17.4.92.4e1206f",
    "description": "Weasel (小狼毫) - fxliang Personal Build",
    "homepage": "https://github.com/fxliang/weasel",
    "license": "GPL-3.0-or-later",

    "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-0.17.4.92.4e1206f-installer.exe#/weasel-installer.exe",
    "hash": "c2669ca6f223184fd682e3b6e75ad71910e0d7cd26d66eb800d5937d9d8b6023",

    "installer": {
        "script": [
            "$installer = Join-Path $dir 'weasel-installer.exe'",
            "$process = Start-Process -FilePath $installer -ArgumentList '/S' -Verb RunAs -PassThru -Wait",
            "if ($process.ExitCode -ne 0) { throw \"Weasel installer failed with exit code $($process.ExitCode)\" }"
        ]
    },

    "persist": [
        "Rime"
    ],

    "post_install": [
        "$userDir = Join-Path $persist_dir 'Rime'",
        "New-Item -ItemType Directory -Force -Path $userDir | Out-Null",

        "$regPath = if ([Environment]::Is64BitOperatingSystem) { 'HKLM:\\SOFTWARE\\WOW6432Node\\Rime\\Weasel' } else { 'HKLM:\\SOFTWARE\\Rime\\Weasel' }",
        "$props = Get-ItemProperty -Path $regPath -ErrorAction Stop",
        "$weaselRoot = $props.WeaselRoot",

        "if (-not $weaselRoot -or -not (Test-Path $weaselRoot)) { throw 'Weasel installation directory not found in registry.' }",

        "$setup = Join-Path $weaselRoot 'WeaselSetup.exe'",
        "if (Test-Path $setup) {",
        "    $process = Start-Process -FilePath $setup -ArgumentList \"/userdir:$userDir\" -PassThru -Wait",
        "    if ($process.ExitCode -ne 0) { throw \"WeaselSetup failed with exit code $($process.ExitCode)\" }",
        "}",

        "$deployer = Join-Path $weaselRoot 'WeaselDeployer.exe'",
        "if (Test-Path $deployer) {",
        "    $process = Start-Process -FilePath $deployer -ArgumentList '/deploy' -WorkingDirectory $weaselRoot -PassThru -Wait",
        "    if ($process.ExitCode -ne 0) { throw \"Weasel deploy failed with exit code $($process.ExitCode)\" }",
        "}"
    ],

    "uninstaller": {
        "script": [
            "$regPath = if ([Environment]::Is64BitOperatingSystem) { 'HKLM:\\SOFTWARE\\WOW6432Node\\Rime\\Weasel' } else { 'HKLM:\\SOFTWARE\\Rime\\Weasel' }",

            "if (Test-Path $regPath) {",
            "    $props = Get-ItemProperty -Path $regPath -ErrorAction SilentlyContinue",
            "    $weaselRoot = $props.WeaselRoot",

            "    if ($weaselRoot -and (Test-Path $weaselRoot)) {",
            "        $server = Join-Path $weaselRoot 'WeaselServer.exe'",
            "        if (Test-Path $server) {",
            "            & $server '/quit'",
            "        }",

            "        $uninstaller = Join-Path $weaselRoot 'uninstall.exe'",
            "        if (Test-Path $uninstaller) {",
            "            $arguments = \"/S _?=$weaselRoot\"",
            "            $process = Start-Process -FilePath $uninstaller -ArgumentList $arguments -Verb RunAs -PassThru -Wait",
            "            if ($process.ExitCode -ne 0) { throw \"Weasel uninstaller failed with exit code $($process.ExitCode)\" }",
            "        }",
            "    }",
            "}"
        ]
    },

    "checkver": {
        "url": "https://api.github.com/repos/fxliang/weasel/releases/tags/pblatest",
        "regex": "weasel-(?<version>[\\d.]+\\.[0-9a-f]+)-installer\\.exe"
    },

    "autoupdate": {
        "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-$version-installer.exe#/weasel-installer.exe"
    }
}
