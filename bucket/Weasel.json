{
    "version": "0.17.4.92",
    "description": "Weasel (小狼毫) - fxliang Personal Build",
    "homepage": "https://github.com/fxliang/weasel",
    "license": "GPL-3.0-or-later",

    "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-0.17.4.92.4e1206f-installer.exe#/weasel-installer.exe",
    "hash": "c2669ca6f223184fd682e3b6e75ad71910e0d7cd26d66eb800d5937d9d8b6023",

    "installer": {
        "args": [
            "/S",
            "/s",
            "/D=$dir"
        ]
    },

    "persist": [
        "Rime"
    ],

    "post_install": [
        "$weaselRoot = Get-ChildItem -Path $dir -Directory -Filter 'weasel-*' | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
        "if (-not $weaselRoot) { throw 'Weasel installation directory not found.' }",
        "$setup = Join-Path $weaselRoot.FullName 'WeaselSetup.exe'",
        "$deployer = Join-Path $weaselRoot.FullName 'WeaselDeployer.exe'",
        "$userDir = Join-Path $dir 'Rime'",
        "if (Test-Path $setup) {",
        "    & $setup \"/userdir:$userDir\"",
        "}",
        "if (Test-Path $deployer) {",
        "    & $deployer '/deploy'",
        "}"
    ],

    "uninstaller": {
        "script": [
            "$weaselRoot = Get-ChildItem -Path $dir -Directory -Filter 'weasel-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
            "if ($weaselRoot) {",
            "    $uninstaller = Join-Path $weaselRoot.FullName 'uninstall.exe'",
            "    if (Test-Path $uninstaller) {",
            "        & $uninstaller '/S'",
            "    }",
            "}"
        ]
    },

    "checkver": {
        "url": "https://api.github.com/repos/fxliang/weasel/releases/tags/pblatest",
        "regex": "weasel-(?<version>[\\d.]+)\\.(?<commit>[0-9a-f]+)-installer\\.exe"
    },

    "autoupdate": {
        "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-$version.$matchCommit-installer.exe#/weasel-installer.exe"
    }
}
