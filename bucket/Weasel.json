{
    "version": "0.17.4.92.4e1206f",
    "description": "Weasel (小狼毫) - fxliang Personal Build",
    "homepage": "https://github.com/fxliang/weasel",
    "license": "GPL-3.0-or-later",

    "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-0.17.4.92.4e1206f-installer.exe#/weasel-installer.exe",
    "hash": "c2669ca6f223184fd682e3b6e75ad71910e0d7cd26d66eb800d5937d9d8b6023",

    "installer": {
        "script": [
            "$installer = Join-Path $dir 'weasel-installer.exe'",
            "$arguments = @('/S', '/s', \"/D=$dir\")",
            "$process = Start-Process -FilePath $installer -ArgumentList $arguments -Verb RunAs -PassThru",
            "$process.WaitForExit()",
            "$process.Refresh()",
            "if ($process.ExitCode -ne 0) { throw \"Weasel installer failed with exit code $($process.ExitCode)\" }"
        ]
    },

    "persist": [
        "Rime"
    ],

    "post_install": [
        "$userDir = Join-Path $persist_dir 'Rime'",
        "New-Item -ItemType Directory -Force -Path $userDir | Out-Null",

        "$weaselRoot = Get-ChildItem -Path $dir -Directory -Filter 'weasel-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
        "if (-not $weaselRoot) { throw 'Weasel installation directory not found.' }",

        "$setup = Join-Path $weaselRoot.FullName 'WeaselSetup.exe'",
        "if (Test-Path $setup) {",
        "    & $setup \"/userdir:$userDir\"",
        "}",

        "$deployer = Join-Path $weaselRoot.FullName 'WeaselDeployer.exe'",
        "if (Test-Path $deployer) {",
        "    Start-Process -FilePath $deployer -ArgumentList '/deploy' -WorkingDirectory $weaselRoot.FullName -Wait",
        "}"
    ],

    "uninstaller": {
        "script": [
            "$weaselRoot = Get-ChildItem -Path $dir -Directory -Filter 'weasel-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1",
            "if ($weaselRoot) {",
            "    $server = Join-Path $weaselRoot.FullName 'WeaselServer.exe'",
            "    if (Test-Path $server) {",
            "        & $server '/quit'",
            "    }",

            "    $uninstaller = Join-Path $weaselRoot.FullName 'uninstall.exe'",
            "    if (Test-Path $uninstaller) {",
            "        $process = Start-Process -FilePath $uninstaller -ArgumentList '/S' -Verb RunAs -PassThru",
            "        $process.WaitForExit()",
            "    }",
            "}"
        ]
    },

    "checkver": {
        "url": "https://api.github.com/repos/fxliang/weasel/releases/tags/pblatest",
        "regex": "weasel-(?<version>[\\d.]+\\.[0-9a-f]+)-installer\\.exe"
    },

    "autoupdate": {
        "url": "https://github.com/fxliang/weasel/releases/download/pblatest/weasel-$version-installer.exe#/weasel-installer.exe"
    }
}
