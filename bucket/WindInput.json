{
    "version": "0.119.0",
    "description": "清风输入法（WindInput）",
    "homepage": "https://github.com/huanfeng/WindInput",
    "license": "GPL-3.0-or-later",
    "url": "https://github.com/huanfeng/WindInput/releases/download/v0.119.0/WindInput-Portable-0.119.0.zip",
    "hash": "ab0552603257fae3f02910ab324a09286e312de635fa8c17a8df242268b40cca",
    "extract_dir": "WindInput-0.119.0",

    "persist": "userdata",

    "installer": {
        "script": [
            "info 'Registering WindInput TSF and starting service...'",
            "$proc = Start-Process -FilePath \"$dir\\wind_portable.exe\" -ArgumentList '-start' -WorkingDirectory \"$dir\" -PassThru",
            "$proc.WaitForExit()",
            "if ($proc.ExitCode -ne 0) { throw \"WindInput installation failed with exit code $($proc.ExitCode)\" }"
        ]
    },

    "pre_uninstall": [
        "if (Test-Path \"$dir\\wind_portable.exe\") {",
        "    info 'Stopping WindInput service and unregistering TSF...'",
        "    $proc = Start-Process -FilePath \"$dir\\wind_portable.exe\" -ArgumentList '-stop' -WorkingDirectory \"$dir\" -PassThru",
        "    $proc.WaitForExit()",
        "    if ($proc.ExitCode -ne 0) { throw \"WindInput unregistration failed with exit code $($proc.ExitCode)\" }",
        "}"
    ],

    "checkver": {
        "github": "https://github.com/huanfeng/WindInput"
    },

    "autoupdate": {
        "url": "https://github.com/huanfeng/WindInput/releases/download/v$version/WindInput-Portable-$version.zip",
        "extract_dir": "WindInput-$version"
    }
}
